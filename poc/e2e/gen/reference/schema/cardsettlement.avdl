namespace gen.cardsettlement;

schema CardSettlement;

fixed Id(8);

record Money {
  string currency_code;
  bytes amount;
}

enum EntryMode {
  CHIP,
  CONTACTLESS,
  ECOM,
  SWIPE,
  MANUAL
}

enum Network {
  VISA,
  MASTERCARD,
  AMEX,
  DISCOVER
}

record CardSettlement {
  Id id;
  string key;
  long merchant_id;
  string terminal_id;
  int card_bin;
  string card_last4;
  string auth_code;
  Money amount;
  Money interchange_fee;
  long txn_time;
  int settle_date;
  int mcc;
  EntryMode entry_mode;
  Network network;
  string arn;
}
